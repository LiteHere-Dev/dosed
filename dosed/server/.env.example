# Copy to .env for local dev. In production, set these as real secrets
# in your host's environment/secrets manager — never commit .env.
DATABASE_URL=postgres://dosed:dosed@localhost:5432/dosed
JWT_SECRET=replace-with-a-long-random-string
PORT=3000
NODE_ENV=development
# Comma-separated list; the mobile app doesn't send an Origin header, so
# this mainly matters if you ever add a web client.
CORS_ORIGINS=

# --- Email (optional) ---
# Leave all of these unset and verification/reset emails are logged to
# stdout instead of sent — the flow still works end-to-end for local dev,
# it just won't reach a real inbox. Any provider that speaks SMTP works:
# Resend, Postmark, SES, Mailgun, or your own mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dosed <no-reply@yourdomain.com>

# --- R2 storage (optional, needed for pet photo sync) ---
# From Cloudflare dashboard -> R2 -> Manage API tokens -> Create API token
# (Object Read & Write, scoped to the one bucket below).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=dosed-photos

# Base for the links inside verification/reset emails. Point this at your
# app's deep link scheme (see app.json's "scheme") so tapping the email
# link opens the app directly to the right screen.
APP_URL=dosed://auth/
